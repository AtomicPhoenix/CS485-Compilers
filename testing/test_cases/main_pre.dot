digraph main_pre {
  n0 [label="(Node 0)\nstart\nt$1 <- true\n"];
 n0 -> n2 [label="!t$1"];
 n0 -> n1 [label="t$1"];
  n1 [label="(Node 1)\nthen branch\nt$2 <- 1\nt$3 <- 1\nt$4 <- t$2\nt$5 <- t$3\nt$0 <- t$4 + t$5\n"];
 n1 -> n3 [label="true"];
  n2 [label="(Node 2)\nelse branch\nt$6 <- 0\nt$7 <- 0\nt$8 <- t$6\nt$9 <- t$7\nt$0 <- t$8 + t$9\n"];
 n2 -> n3 [label="true"];
  n3 [label="(Node 3)\nif-join\nt$0 <- return\n"];
}
