digraph main_post {
  n0 [label="(Node 0)\nstart\n"];
 n0 -> n2 [label="!true"];
 n0 -> n1 [label="true"];
  n1 [label="(Node 1)\nthen branch\nt$0 <- 2\n"];
 n1 -> n3 [label="true"];
  n2 [label="(Node 2)\nelse branch\nt$0 <- 0\n"];
 n2 -> n3 [label="true"];
  n3 [label="(Node 3)\nif-join\nt$0 <- return\n"];
}
